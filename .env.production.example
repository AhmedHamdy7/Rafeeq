# RAFEEQ — a shared server for the mobile team
#
# Copy to `.env`, then `php artisan key:generate`. Every line marked 🔴 is one whose
# wrong value is a security problem rather than a broken feature.
#
# Full walkthrough: deploy/ORACLE_SETUP.md · what each process does: DEPLOYMENT.md

APP_NAME=Rafeeq
APP_KEY=

# 🔴 `production` makes LogOtpSender REFUSE to run, which is deliberate — nothing
# should reach real users without a real SMS provider. That means on a shared team
# server you need either RAFEEQ_DEV_OTP_CODE below, or `staging` here so the
# development transport still works and the code goes to the log.
APP_ENV=staging

# 🔴 `true` renders a debug page carrying the SQL, the environment and parts of the
# source on any unhandled error. Never true on anything reachable from the internet.
APP_DEBUG=false

# 🔴 Must match how the app is actually reached, scheme included. Signed URLs (the
# verification-document links) are generated from this and silently fail to validate
# when it is wrong.
APP_URL=https://api.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# 🔴 `debug` writes the OTP code to the log on any non-production environment. On a
# server other people can reach, that is a sign-in bypass sitting in a file.
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rafeeq
DB_USERNAME=rafeeq
# 🔴 Not empty, not `password`.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# 🔴 The admin dashboard authenticates by session cookie. `true` here encrypts it at
# rest, which matters because the dashboard can read every verification document on
# the platform.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# 🔴 Cookies over HTTPS only. Leave this unset until TLS is actually working, then set
# it — with it on and no TLS, nobody can sign in to the dashboard at all.
SESSION_SECURE_COOKIE=true

# 🔴 Reverb, for live trip positions (decision D6) — and this block ships DISABLED on purpose.
#
# `BROADCAST_CONNECTION=reverb` with the keys below still empty does not degrade; it CRASHES, and
# not in a way that names itself. Laravel builds the broadcaster through the Pusher client, and
# Pusher's constructor type-errors on a null key:
#
#   Pusher\Pusher::__construct(): Argument #1 ($auth_key) must be of type string, null given
#
# That is thrown while `routes/channels.php` is being loaded, which happens during `route:cache` —
# so the container dies at boot and the platform reports only "Application failed to respond". This
# file shipped with `reverb` and empty keys, and it cost a real deploy to find.
#
# `log` writes broadcasts to the log and boots cleanly. The only thing that does not work is the
# live map moving by itself; the app's polling fallback (`GET /trips/{trip}/location`) still works,
# which is why this is a safe default rather than a broken one.
#
# To turn it on you need BOTH: the three secrets below (`openssl rand -hex 16` each) AND a running
# `php artisan reverb:start` service. The entrypoint refuses to boot if you set one without the
# other.
BROADCAST_CONNECTION=log

# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# What the mobile app connects to: the public host, through nginx, over TLS. Different
# from REVERB_HOST above, which is where the server itself listens.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=api.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# 🔒 Whether /docs/api is open to anyone who knows the URL. Off by default.
#
# The OpenAPI document is the complete API surface — every endpoint, field name and error
# code. It hands out no data and bypasses no check; it hands out a MAP, which is the first
# thing somebody probing the platform would collect. On a staging box with seeded fictional
# journeys that trade is worth it, and it is the alternative to emailing a JSON file after
# every change. On an instance holding real journeys it is not — so the gate refuses outright
# when APP_ENV=production, whatever this is set to.
RAFEEQ_PUBLIC_API_DOCS=false

FILESYSTEM_DISK=local

# 🔴 A queue worker MUST be running (deploy/systemd/rafeeq-queue.service). Without
# one, jobs sit in the `jobs` table for ever and nothing reports an error.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Rafeeq's own settings
# ---------------------------------------------------------------------------
# Almost every policy number lives in `platform_settings` and is changed from the
# dashboard, not here (standard #11). These are the few that are infrastructure.

RAFEEQ_TERMS_VERSION=1.0
RAFEEQ_PRIVACY_VERSION=1.0

# 🔴 Identity documents. `documents` is private local storage — fine for a team
# server, wrong for production, where decision D7 requires a private S3 bucket with
# presigned URLs. Turn the second on at the same time as switching the disk.
RAFEEQ_DOCUMENTS_DISK=documents
RAFEEQ_PRESIGNED_DOCUMENT_URLS=false

# 🔴 The upload scanner. `signature` is the development one and REFUSES to run in
# production, so a deploy without a real engine fails loudly rather than waving
# malware through. It stays here only because this is a team server.
RAFEEQ_VIRUS_SCANNER=signature

# ---------------------------------------------------------------------------
# 🔴 The OTP, and the thing that will stop the mobile team within an hour
# ---------------------------------------------------------------------------
# There is no SMS provider yet (open question #2). The only transport writes the code
# to the log, which the mobile team cannot read — so they reach the OTP screen and
# stop.
#
# Setting this makes every code the same fixed value, on any non-production
# environment. It is gated on the ENVIRONMENT, not on this line: config is exactly
# what a wrong deploy gets wrong.
#
# Exactly `auth.otp.length` digits (6 by default). Empty disables it and codes are random
# again. In production it does not silently switch off — the app REFUSES to issue a code at
# all, because quietly doing the safe thing is how a fixed OTP stays configured.
RAFEEQ_DEV_OTP_CODE=
